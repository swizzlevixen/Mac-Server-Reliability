<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.admin.nas-early-mount</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/usr/local/libexec/nas-early-mount.sh</string>
	</array>
	<!-- Once at boot, before login, so the shares are there before any app starts -->
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/nas-early-mount.log</string>
</dict>
</plist>
